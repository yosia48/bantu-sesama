# ===========================================
# BantuSesama - Environment Variables
# ===========================================

# API Backend URL (Cloudflare Worker)
# Setelah deploy Worker, set URL di sini:
# Contoh: https://bantu-sesama-api.username.workers.dev
NEXT_PUBLIC_API_URL=

# Cara setup:
# 1. Deploy Cloudflare Worker:
#    cd worker && npx wrangler deploy
#
# 2. Copy URL Worker yang didapat
#
# 3. Untuk development lokal:
#    cp .env.example .env.local
#    Edit .env.local dan isi NEXT_PUBLIC_API_URL
#
# 4. Untuk production (Cloudflare Pages):
#    Dashboard → Pages → bantu-sesama → Settings → Environment variables
#    Tambahkan: NEXT_PUBLIC_API_URL = https://bantu-sesama-api.<username>.workers.dev
